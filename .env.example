# =========================================
# OFFER 预备役 · 环境变量示例
# 复制为 .env 后填入真实值（不要提交 .env）
# =========================================

# 飞书应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=
FEISHU_ENCRYPT_KEY=

# 飞书多维表格
FEISHU_BASE_TOKEN=
TABLE_ID_USER_PROFILE=
TABLE_ID_FIELD_OPTIONS=
TABLE_ID_JD_POOL=
TABLE_ID_OKR=
TABLE_ID_KR_PROGRESS=
TABLE_ID_LEARNING_LOG=
TABLE_ID_INTERNSHIP_MATCH=
TABLE_ID_AI_ADVICE=
TABLE_ID_MODEL_CONFIG=
TABLE_ID_MCP_SOURCE=

# 飞书云文档根目录
FEISHU_KNOWLEDGE_SPACE_ID=
FEISHU_REPORT_FOLDER_TOKEN=
FEISHU_ADVICE_FOLDER_TOKEN=
FEISHU_PATH_FOLDER_TOKEN=

# 飞书群聊
FEISHU_CHAT_ID=

# Web 服务
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_PUBLIC_URL=http://localhost:8000

# 加密密钥（用于 T9/T10 表中敏感字段的对称加密）
SECRET_FERNET_KEY=

# 模型路由配置热加载间隔（秒）
MODEL_RELOAD_INTERVAL=60

# 注意：不内置任何模型 Key，完全由 T9 表加载
